#!/usr/bin/env perl
# ABSTRACT: CLI for the MetaForge ARC Raiders API
# PODNAME: metaforge-arcraiders

use strict;
use warnings;
use open ':std', ':encoding(UTF-8)';
use WWW::MetaForge::ArcRaiders::CLI;

WWW::MetaForge::ArcRaiders::CLI->new_with_cmd;

=head1 SYNOPSIS

  # List all items
  metaforge-arcraiders items

  # Search items
  metaforge-arcraiders items --search Ferro

  # Show single item details
  metaforge-arcraiders item ferro-i

  # List quests
  metaforge-arcraiders quests

  # List traders
  metaforge-arcraiders traders

  # Show event timers
  metaforge-arcraiders events

=head1 DESCRIPTION

Command-line interface for querying the MetaForge ARC Raiders API.

